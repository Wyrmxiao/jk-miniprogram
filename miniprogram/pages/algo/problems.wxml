<view class="page">
  <view class="blobs">
    <view class="blob blob--1"></view>
    <view class="blob blob--2"></view>
    <view class="blob blob--3"></view>
  </view>
  <view class="hero">
    <view class="hero__title">{{tagName}} · {{bandName}}</view>
    <view class="hero__sub">已做 {{doneCount}} / {{list.length}}</view>
  </view>

  <view wx:if="{{loading}}" class="state-empty">加载中…</view>

  <view wx:elif="{{list.length === 0}}" class="empty">
    <view class="empty__emoji">🌵</view>
    <view>本档题目较少，换个档位试试</view>
  </view>

  <view wx:else class="group">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="prob pressable {{item.done ? 'prob--done' : ''}}"
      hover-class="pressing"
      data-id="{{item.id}}"
      bindtap="goProblem"
    >
      <view class="prob__dot {{item.done ? 'prob__dot--on' : ''}}">{{item.done ? '✓' : ''}}</view>
      <view class="prob__body">
        <view class="prob__title text-ellipsis">{{item.titleCn || item.title}}</view>
        <view class="prob__meta">{{item.pid}} · {{item.source === 'codeforces' ? 'CF' : '力扣'}}{{item.rating ? ' · ' + item.rating : ''}}{{item.titleCn ? ' · ' + item.title : ''}}</view>
      </view>
      <view
        wx:if="{{!item.done}}"
        class="prob__btn pressable {{markingId === item.id ? 'prob__btn--doing' : ''}}"
        hover-class="pressing"
        data-id="{{item.id}}"
        catchtap="mark"
      >通过</view>
    </view>
  </view>

  <view class="safe-bottom"></view>

  <view wx:if="{{nextItem}}" class="prob__next pressable" bindtap="goNext" hover-class="pressing">
    <text class="prob__next-label">下一题</text>
    <text class="prob__next-title text-ellipsis">{{nextItem.titleCn || nextItem.title}}</text>
    <text class="prob__next-arrow">›</text>
  </view>

  <!-- AI 悬浮球助手 -->
  <ai-float />
</view>

<view class="page">
  <view class="blobs">
    <view class="blob blob--1"></view>
    <view class="blob blob--2"></view>
    <view class="blob blob--3"></view>
  </view>

  <view class="hero">
    <view class="hero__title">我的班级</view>
    <view class="hero__sub">老师只看自己班的学习汇报，学生可加入多个班</view>
    <view class="hero__btns">
      <view class="btn btn-sm pressable" hover-class="pressing" bindtap="toggleCreate">
        {{showCreate ? '收起' : '＋ 创建班级'}}
      </view>
      <view class="btn-ghost btn-sm pressable" hover-class="pressing" bindtap="goJoin">加入班级</view>
    </view>
  </view>

  <!-- 创建班级 -->
  <view wx:if="{{showCreate}}" class="block">
    <view class="block__title">创建班级</view>
    <input
      class="field"
      placeholder="班级名称，如：2024级算法组"
      maxlength="20"
      value="{{form.name}}"
      data-field="name"
      bindinput="onInput"
      cursor-spacing="120"
    />
    <textarea
      class="field field--area"
      placeholder="简介（可选）：一周交一次汇报，周日 23:59 截止…"
      maxlength="100"
      value="{{form.intro}}"
      data-field="intro"
      bindinput="onInput"
      auto-height
      cursor-spacing="200"
    />
    <view class="form-actions">
      <view class="btn-ghost btn-sm pressable" hover-class="pressing" bindtap="toggleCreate">取消</view>
      <view class="btn btn-sm pressable {{creating ? 'btn-disabled' : ''}}" hover-class="pressing" bindtap="create">
        {{creating ? '创建中…' : '创建'}}
      </view>
    </view>
  </view>

  <!-- 班级列表 -->
  <view class="block">
    <view class="block__title">我加入的班级</view>
    <view wx:if="{{loading}}" class="empty empty--inline">正在加载…</view>
    <view wx:elif="{{list.length === 0}}" class="empty empty--inline">
      还没有班级。老师可以创建班级，学生输入邀请码或扫码加入。
    </view>
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="ccard pressable"
      hover-class="pressing"
      data-id="{{item._id}}"
      data-code="{{item.code}}"
      bindtap="openDetail"
      bindlongpress="copyCode"
    >
      <view class="ccard__head">
        <text class="ccard__name">{{item.name}}</text>
        <text wx:if="{{item.isOwner}}" class="tag tag-primary">我创建的</text>
        <text wx:elif="{{item.submittedThisWeek}}" class="tag tag-success">本周已交</text>
      </view>
      <view wx:if="{{!isTeacherMode && !item.submittedThisWeek}}" class="ccard__warn">
        本周学习汇报还没提交
      </view>
      <view wx:if="{{item.intro}}" class="ccard__intro">{{item.intro}}</view>
      <view class="ccard__meta">
        <text>{{item.memberCount}} 人</text>
        <text class="ccard__code">邀请码 {{item.code}}</text>
        <text class="ccard__chevron">›</text>
      </view>
    </view>
    <view wx:if="{{list.length > 0}}" class="block__foot">
      <text class="hint">长按班级卡片可复制邀请码</text>
    </view>
  </view>
</view>

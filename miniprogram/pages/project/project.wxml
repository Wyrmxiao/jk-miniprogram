<view class="page">
  <!-- 头部 -->
  <view class="hero">
    <view class="hero__title">项目</view>
    <view class="hero__sub">记录你的创造，展示你的成果</view>
  </view>

  <!-- 阶段筛选 -->
  <scroll-view scroll-x class="chips" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{stages}}"
      wx:key="key"
      class="chip {{activeStage === item.key ? 'chip--on' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchStage"
    >{{item.name}}</view>
    <view class="chip {{onlyMine ? 'chip--mine' : ''}}" bindtap="toggleMine">我的项目</view>
  </scroll-view>

  <!-- 项目卡片流 -->
  <view wx:if="{{!loading}}" class="list">
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="card pressable"
      hover-class="pressing"
      data-id="{{item._id}}"
      bindtap="goDetail"
    >
      <view wx:if="{{item.featured}}" class="card__star">⭐ 教师推荐</view>
      <view class="card__head">
        <view class="card__avatar">{{item.ownerName[0] || '项'}}</view>
        <view class="card__who">
          <view class="card__name">{{item.name}}</view>
          <view class="card__owner">{{item.ownerName}} · {{item.timeText}}</view>
        </view>
      </view>
      <view wx:if="{{item.summary}}" class="card__summary">{{item.summary}}</view>
      <view class="card__tags">
        <text class="tag tag--stage-{{item.stage}}">{{item.stageText}}</text>
        <text class="tag">{{item.directionText}}</text>
      </view>
      <view class="card__meta">📝 {{item.updateCount || 0}} 进展 · 💬 {{item.commentCount || 0}} 留言 · 👀 {{item.viewCount || 0}}</view>
    </view>

    <view wx:if="{{noMore && list.length}}" class="list__end">— 没有更多了 —</view>
    <view wx:if="{{!list.length}}" class="empty">
      <view class="empty__emoji">🚀</view>
      <view class="empty__text">{{onlyMine ? '你还没有创建项目' : '还没有项目，来创建第一个吧'}}</view>
    </view>
  </view>

  <!-- 创建入口 -->
  <view class="fab" bindtap="goCreate">＋</view>
</view>

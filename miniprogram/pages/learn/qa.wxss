/* pages/learn/qa.wxss —— 学习问答列表 */
.page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: var(--bg-page);
}

.unverified {
  margin: var(--space-xl) var(--space-lg);
  padding: var(--space-xl);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  text-align: center;
}
.unverified__title { font-size: var(--font-body); color: var(--text-primary); margin-bottom: var(--space-lg); }

/* ===== 概览数字 ===== */
.stats {
  display: flex;
  align-items: center;
  margin: var(--space-md) var(--space-lg) 0;
  padding: var(--space-md) 0;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.stats__item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stats__n { font-size: 44rpx; font-weight: 560; color: var(--text-primary); line-height: 1.1; }
.stats__n--open { color: var(--text-primary); }
.stats__n--done { color: var(--text-primary); }
.stats__label { margin-top: 8rpx; font-size: var(--font-micro); color: var(--text-tertiary); }
.stats__sep { width: 2rpx; height: 48rpx; background: var(--border-light); }

/* ===== 搜索 ===== */
.search {
  display: flex;
  align-items: center;
  margin: var(--space-md) var(--space-lg) 0;
  padding: 0 var(--space-sm) 0 var(--space-md);
  height: 96rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}
.search__input { flex: 1; min-width: 0; font-size: var(--font-body); color: var(--text-primary); }
.search__clear {
  width: 44rpx; height: 88rpx; line-height: 88rpx; text-align: center;
  color: var(--text-tertiary); font-size: 36rpx; flex-shrink: 0;
}
.search__go {
  padding: 0 28rpx; height: 88rpx; border-radius: var(--radius-pill);
  background: var(--color-primary-light); color: var(--color-primary-dark);
  font-size: var(--font-caption); font-weight: 500;
  display: flex; align-items: center; flex-shrink: 0;
}

/* ===== 横向滚动分段控件：覆盖 mixins 中等宽 .seg 的布局与底色 ===== */
.seg--scroll {
  display: block;
  margin: var(--space-md) 0 0;
  padding: 0 var(--space-lg);
  background: transparent;
  border-radius: 0;
  white-space: nowrap;
}
.seg__inner { display: inline-flex; align-items: center; gap: 8rpx; }
.seg--scroll .seg__item {
  display: inline-block;
  flex: none;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-pill);
}
.seg--scroll .seg__item--on {
  background: var(--color-primary);
  color: #fff;
  box-shadow: none;
}

.cats { margin-top: var(--space-sm); padding: 0 var(--space-lg); white-space: nowrap; }
.cats__inner { display: inline-flex; gap: var(--space-sm); padding-bottom: 4rpx; }
.cat {
  display: inline-block;
  padding: 10rpx 26rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-card);
  border: none;
  font-size: var(--font-caption);
  color: var(--text-secondary);
  flex-shrink: 0;
  min-height: 80rpx;
}
.cat--on {
  background: var(--color-primary-light);
  border-color: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-weight: 500;
}

/* ===== 问题卡片 ===== */
.list { padding: var(--space-sm) var(--space-lg) 0; }
.qcard {
  margin-bottom: var(--space-md);
  padding: var(--space-lg);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.qcard__top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; }
.qcard__cat {
  padding: 4rpx 18rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-block);
  color: var(--text-secondary);
  font-size: var(--font-micro);
}
.qcard__title {
  margin-top: var(--space-sm);
  font-size: var(--font-body);
  font-weight: 560;
  color: var(--text-primary);
  line-height: 1.5;
}
.qcard__summary {
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--text-secondary);
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.qcard__problem {
  margin-top: var(--space-sm);
  padding: 8rpx var(--space-sm);
  border-radius: var(--radius-sm);
  background: var(--bg-block);
  font-size: var(--font-micro);
  color: var(--text-tertiary);
}
.qcard__foot {
  display: flex; align-items: center; gap: var(--space-sm);
  margin-top: var(--space-md);
  font-size: var(--font-micro);
  color: var(--text-tertiary);
  flex-wrap: wrap;
}
.qcard__author { color: var(--text-secondary); }
.qcard__role {
  margin-left: 8rpx; padding: 2rpx 10rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary-light); color: var(--color-primary-dark);
}
.qcard__answer { margin-left: auto; color: var(--color-warning); }
.qcard__answer--done { color: var(--color-success); }
.qcard__time { flex-shrink: 0; }

.state { padding: var(--space-xl) 0; text-align: center; font-size: var(--font-caption); color: var(--text-secondary); }
.state--empty { display: flex; flex-direction: column; align-items: center; }
.state__emoji { font-size: 72rpx; margin-bottom: var(--space-sm); }
.state__tip { margin-top: 8rpx; font-size: var(--font-micro); color: var(--text-tertiary); }
.more { padding: var(--space-md) 0; text-align: center; font-size: var(--font-caption); color: var(--color-primary); }
.more--end { color: var(--text-tertiary); }

/* ===== 提问按钮（问题卡片上方，与卡片等宽） ===== */
.ask-top {
  width: 100%;
  margin-top: var(--space-sm);
}

/* 提问弹层要盖过 AI 悬浮球（全局 .mask z-index:100 < 悬浮球 900） */
.mask--ask { z-index: 1200; }

/* ===== 提问弹层：表单可滚，发布条固定在底部 ===== */
.form-label { margin-top: var(--space-md); font-size: var(--font-caption); color: var(--text-secondary); font-weight: 500; }
.counter { margin-top: 8rpx; text-align: right; font-size: var(--font-micro); color: var(--text-tertiary); }
.form-tail { height: 16rpx; }

.sheet--ask {
  display: flex;
  flex-direction: column;
  max-height: 88vh;
  overflow: hidden;
  padding-bottom: 0;
}
.sheet__body { flex: 1; min-height: 0; overflow-y: auto; }
.sheet__actions {
  flex-shrink: 0;
  padding: var(--space-md) 0 calc(var(--space-md) + env(safe-area-inset-bottom));
  background: var(--bg-elevated);
  border-top: 2rpx solid var(--border-light);
}
.sheet__actions .btn { margin-top: 0; }
.ask-hint {
  margin-bottom: 12rpx;
  text-align: center;
  font-size: var(--font-micro);
  color: var(--color-warning);
}

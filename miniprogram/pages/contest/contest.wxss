/* pages/contest/contest.wxss —— Apple 风格赛事库 */
.page {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background: transparent;
}

/* ===== 筛选 chips（白底胶囊） ===== */
.chips {
  white-space: nowrap;
  padding: var(--space-sm) var(--space-lg) var(--space-xs);
}
.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: var(--space-sm);
  border-radius: var(--radius-pill);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
  font-size: var(--font-caption);
  color: var(--text-secondary);
  transition: transform 0.12s var(--ease-press);
  min-height: 80rpx;
}
.chip--on {
  background: var(--color-primary);
  color: #fff;
  font-weight: 500;
}
.chip--pressing { transform: scale(0.95); }

/* ===== 赛事卡片 ===== */
.list { padding: 0 var(--space-lg); }
.card {
  margin: 0 0 var(--space-md);
  padding: var(--space-lg);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.card__head { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
.card__name { flex: 1; margin-right: var(--space-sm); font-size: var(--font-body); font-weight: 560; color: var(--text-primary); line-height: 1.5; }
.card__tags { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: var(--space-sm); }
.card__tags .tag { margin-right: var(--space-sm); }

.card__time { display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: var(--space-md);
  padding-top: var(--space-md);
  border-top: 2rpx solid var(--border-light);
  font-size: var(--font-caption);
  color: var(--text-secondary);
}
.card__time-dot { width: 12rpx; height: 12rpx; margin-right: var(--space-sm); border-radius: 50%; background: var(--text-tertiary); }
.time--exact .card__time-dot { background: var(--color-primary); }
.time--soon .card__time-dot { background: var(--color-warning); }
.time--pending .card__time-dot { background: var(--text-tertiary); }
.card__time-badge {
  margin-left: var(--space-sm);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  background: var(--color-warning-light);
  color: var(--color-warning);
  font-size: var(--font-micro);
}
.card__time-note { margin-left: var(--space-sm); color: var(--text-tertiary); font-size: var(--font-micro); }

/* ===== 状态 ===== */
.state { padding: var(--space-xl) 0; text-align: center; font-size: var(--font-caption); color: var(--text-secondary); }
.state--empty { display: flex; flex-direction: column; align-items: center; }
.state__emoji { font-size: 72rpx; margin-bottom: var(--space-sm); }
.state--end { color: var(--text-tertiary); font-size: var(--font-micro); }

/* ===== 本地收藏星标 ===== */
.fav {
  position: relative;
  flex-shrink: 0;
  margin-right: var(--space-sm);
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--text-tertiary);
}
.fav--on { color: var(--color-warning); }

/* 关注成功：星星弹一下 */
.fav--burst .fav__star { animation: fav-pop 0.4s ease-out; }
@keyframes fav-pop {
  0% { transform: scale(1); }
  40% { transform: scale(1.5); }
  100% { transform: scale(1); }
}

/* 碎光：6 个小光点从星星四周蹦出后消散 */
.fav__spark {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  margin: -5rpx 0 0 -5rpx;
  border-radius: 50%;
  opacity: 0;
  pointer-events: none;
}
.fav__spark--1 { background: #ffb300; }
.fav__spark--2 { background: #ffd666; }
.fav__spark--3 { background: #ff9a3c; }
.fav__spark--4 { background: #ffe7a3; }
.fav__spark--5 { background: #ffb300; }
.fav__spark--6 { background: #ff7a45; }

.fav--burst .fav__spark { animation: fav-spark 0.55s ease-out forwards; }
.fav--burst .fav__spark--1 { animation-delay: 0.02s; }
.fav--burst .fav__spark--2 { animation-delay: 0.06s; }
.fav--burst .fav__spark--3 { animation-delay: 0.1s; }
.fav--burst .fav__spark--4 { animation-delay: 0.08s; }
.fav--burst .fav__spark--5 { animation-delay: 0.12s; }
.fav--burst .fav__spark--6 { animation-delay: 0.04s; }

@keyframes fav-spark {
  0% { opacity: 1; transform: translate(0, 0) scale(1); }
  100% { opacity: 0; transform: translate(0, -44rpx) scale(0.3); }
}
.fav--burst .fav__spark--1 { animation-name: fav-spark-1; }
.fav--burst .fav__spark--2 { animation-name: fav-spark-2; }
.fav--burst .fav__spark--3 { animation-name: fav-spark-3; }
.fav--burst .fav__spark--4 { animation-name: fav-spark-4; }
.fav--burst .fav__spark--5 { animation-name: fav-spark-5; }
.fav--burst .fav__spark--6 { animation-name: fav-spark-6; }

@keyframes fav-spark-1 { 0% { opacity: 1; transform: translate(0, 0) scale(1); } 100% { opacity: 0; transform: translate(-36rpx, -44rpx) scale(0.3); } }
@keyframes fav-spark-2 { 0% { opacity: 1; transform: translate(0, 0) scale(1); } 100% { opacity: 0; transform: translate(0, -52rpx) scale(0.4); } }
@keyframes fav-spark-3 { 0% { opacity: 1; transform: translate(0, 0) scale(1); } 100% { opacity: 0; transform: translate(40rpx, -38rpx) scale(0.3); } }
@keyframes fav-spark-4 { 0% { opacity: 1; transform: translate(0, 0) scale(1); } 100% { opacity: 0; transform: translate(-50rpx, 8rpx) scale(0.35); } }
@keyframes fav-spark-5 { 0% { opacity: 1; transform: translate(0, 0) scale(1); } 100% { opacity: 0; transform: translate(50rpx, 6rpx) scale(0.35); } }
@keyframes fav-spark-6 { 0% { opacity: 1; transform: translate(0, 0) scale(1); } 100% { opacity: 0; transform: translate(0, 46rpx) scale(0.3); } }



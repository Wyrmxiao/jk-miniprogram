/* pages/contest/detail/detail.wxss —— 赛事详情 */
@import '../../../styles/variables.wxss';
@import '../../../styles/mixins.wxss';

.detail__title {
  font-size: var(--font-title);
  line-height: 1.4;
}

/* 头部徽章行（白底胶囊内的说明文字） */
.hero__meta {
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.95);
  margin-left: var(--space-sm);
}

/* 时间行 */
.time-row {
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  padding: 12rpx 0;
}
.time-row__label { font-size: var(--font-body); color: var(--text-secondary); }
.time-row__value { font-size: var(--font-body); color: var(--text-primary); }
.time-row__value--strong { font-weight: 600; color: var(--color-primary); }

/* 说明文字 */
.detail__note {
  font-size: var(--font-caption);
  color: var(--text-secondary);
  line-height: 1.7;
}
.detail__tip {
  font-size: var(--font-micro);
  color: var(--text-tertiary);
  line-height: 1.6;
}

/* 官网链接 */
.detail__url {
  word-break: break-all;
  color: var(--color-primary);
}

/* 简介 */
.detail__intro {
  font-size: var(--font-body);
  color: var(--text-primary);
  line-height: 1.8;
}

/* 底部操作栏 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  flex-direction: row;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  background: var(--glass-bg, rgba(255, 255, 255, 0.92));
  backdrop-filter: blur(20px);
  border-top: 2rpx solid var(--border-light);
}
.footer .btn { flex: 1; }
.footer .btn-plain { max-width: 220rpx; margin-right: var(--space-md); }

/* pages/contest/detail/detail.wxss —— 赛事详情 */
@import '../../../styles/variables.wxss';
@import '../../../styles/mixins.wxss';

.detail__title {
  font-size: var(--font-title);
  line-height: 1.4;
}

/* 头部徽章行（白底胶囊内的说明文字） */
.hero__meta {
  font-size: var(--font-caption);
  color: var(--text-secondary);
  margin-left: var(--space-sm);
}

/* 时间行 */
.time-row { display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  padding: 12rpx 0;
  flex-wrap: wrap;
}
.time-row__label { font-size: var(--font-body); color: var(--text-secondary); }
.time-row__value { font-size: var(--font-body); color: var(--text-primary); }
.time-row__value--strong { font-weight: 560; color: var(--color-primary); }

/* 说明文字 */
.detail__note {
  font-size: var(--font-caption);
  color: var(--text-secondary);
  line-height: 1.7;
}
.detail__tip {
  font-size: var(--font-micro);
  color: var(--text-tertiary);
  line-height: 1.6;
}

/* 官网链接 */
.detail__url {
  word-break: break-all;
  color: var(--color-primary);
}

/* 简介 */
.detail__intro {
  font-size: var(--font-body);
  color: var(--text-primary);
  line-height: 1.8;
}

/* 底部操作栏 */
.footer { display: flex;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  flex-direction: row;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  background: var(--glass-bg, rgba(255, 255, 255, 0.92));
  backdrop-filter: blur(20px);
  border-top: 2rpx solid var(--border-light);
}
.footer .btn { flex: 1; }
.footer .btn-plain { max-width: 220rpx; margin-right: var(--space-md); }

.contest-detail-page { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.hero__btns { margin-top: var(--space-sm); }

/* ===== 我的参赛登记 ===== */
.cell--top { align-items: flex-start; padding-top: var(--space-md); }
.reg__opts { margin-top: var(--space-sm); }
.reg__hint {
  font-size: var(--font-caption);
  color: var(--color-success);
  line-height: var(--leading-normal);
}

/* 自定义开关：完全受 data 控制，避免原生 switch 与云端状态不同步 */
.sw {
  position: relative;
  flex-shrink: 0;
  width: 96rpx;
  height: 56rpx;
  border-radius: var(--radius-pill);
  background: rgba(154, 154, 166, 0.32);
  transition: background var(--duration-normal) var(--ease-spring);
}
.sw--on { background: var(--color-primary); }
.sw__dot {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(14, 14, 18, 0.18);
  transition: transform var(--duration-normal) var(--ease-spring);
}
.sw--on .sw__dot { transform: translateX(40rpx); }

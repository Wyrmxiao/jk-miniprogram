<view class="page contest-detail-page">
  <view class="blobs">
    <view class="blob blob--1"></view>
    <view class="blob blob--2"></view>
    <view class="blob blob--3"></view>
  </view>
  <view wx:if="{{loading}}" class="state">正在加载…</view>

  <view wx:elif="{{detail}}">
    <!-- 头部：赛事名 + 级别 -->
    <view class="hero">
      <view class="hero__title detail__title">{{detail.name}}</view>
      <view class="hero__btns">
        <view class="level level--{{detail.level}}">{{detail.level}}类</view>
        <text wx:if="{{categoryText}}" class="hero__meta">{{categoryText}}</text>
        <text wx:if="{{detail.isFocus}}" class="hero__meta">★ 院内重点</text>
        <text wx:if="{{following}}" class="hero__meta">★ 已关注</text>
      </view>
    </view>

    <!-- 时间安排 -->
    <view class="group">
      <view class="group__title">时间安排</view>
      <view wx:if="{{timeRows.length}}" class="cell">
        <view class="cell__body">
          <view wx:for="{{timeRows}}" wx:key="label" class="time-row">
            <text class="time-row__label">{{item.label}}</text>
            <text class="time-row__value {{item.strong ? 'time-row__value--strong' : ''}}">{{item.value}}</text>
          </view>
        </view>
      </view>
      <view class="cell">
        <view class="cell__body">
          <view class="detail__note">{{timeNote}}</view>
        </view>
      </view>
    </view>

    <!-- 赛事官网 -->
    <view class="group">
      <view class="group__title">赛事官网</view>
      <view wx:if="{{detail.officialUrl}}" class="cell pressable" hover-class="pressing" bindtap="copyUrl">
        <view class="cell__body">
          <view class="cell__title">{{detail.officialName || '赛事官方网站'}}</view>
          <view class="cell__desc detail__url">{{detail.officialUrl}}</view>
        </view>
        <text class="cell__value">复制</text>
        <text class="cell__chevron">›</text>
      </view>
      <view wx:else class="cell">
        <view class="cell__body">
          <view class="detail__note">暂无官网，请联系承办单位</view>
        </view>
      </view>
      <view wx:if="{{detail.officialUrl}}" class="cell">
        <view class="cell__body">
          <view class="detail__tip">复制链接后，在浏览器中打开</view>
        </view>
      </view>
    </view>

    <!-- 主办与来源 -->
    <view class="group">
      <view class="group__title">主办信息</view>
      <view wx:if="{{detail.host}}" class="cell">
        <view class="cell__body">
          <view class="cell__title">承办单位</view>
          <view class="cell__desc">{{detail.host}}</view>
        </view>
      </view>
      <view wx:if="{{detail.source}}" class="cell">
        <view class="cell__body">
          <view class="cell__title">目录来源</view>
          <view class="cell__desc">{{detail.source}}</view>
        </view>
      </view>
    </view>

    <!-- 我的参赛登记：学生自主登记，供比赛统计汇总 -->
    <view class="group">
      <view class="group__title">我的参赛登记</view>

      <view wx:if="{{!isLogin}}" class="cell pressable" hover-class="pressing" bindtap="goLogin">
        <view class="cell__body">
          <view class="cell__title">登录后可登记</view>
          <view class="cell__desc">登记参赛经历与获奖等次，会同步到比赛统计</view>
        </view>
        <text class="cell__chevron">›</text>
      </view>

      <block wx:else>
        <view class="cell">
          <view class="cell__body">
            <view class="cell__title">我参加过这项赛事</view>
            <view class="cell__desc">可随时修改；未获奖也建议登记，用于比赛统计</view>
          </view>
          <view class="sw {{joined ? 'sw--on' : ''}} pressable" hover-class="pressing" bindtap="toggleJoin">
            <view class="sw__dot"></view>
          </view>
        </view>

        <view wx:if="{{joined}}" class="cell cell--top">
          <view class="cell__body">
            <view class="cell__title">获奖等次</view>
            <view class="opts reg__opts">
              <view
                wx:for="{{awardOptions}}"
                wx:key="key"
                class="opt {{award === item.key ? 'opt--on' : ''}}"
                data-key="{{item.key}}"
                bindtap="onAwardPick"
              >{{item.text}}</view>
            </view>
            <view class="detail__tip">以获奖证书为准；不确定时先选「未获奖」</view>
          </view>
        </view>

        <view wx:if="{{joined}}" class="cell pressable" hover-class="pressing" bindtap="editAwardNote">
          <view class="cell__body">
            <view class="cell__title">获奖情况</view>
            <view class="cell__desc">{{awardShow}}</view>
          </view>
          <text class="cell__chevron">✎</text>
        </view>

        <view wx:if="{{regHint}}" class="cell">
          <view class="cell__body">
            <view class="reg__hint">{{regHint}}</view>
          </view>
        </view>
      </block>
    </view>

    <!-- 赛事简介 -->
    <view class="group">
      <view class="group__title">赛事简介</view>
      <view class="cell">
        <view class="cell__body">
          <view wx:if="{{detail.intro}}" class="detail__intro">{{detail.intro}}</view>
          <view wx:else class="detail__note">暂无简介</view>
        </view>
      </view>
    </view>

    <!-- 相关公告 -->
    <view wx:if="{{announcements.length}}" class="group">
      <view class="group__title">相关公告</view>
      <view
        wx:for="{{announcements}}"
        wx:key="_id"
        class="cell pressable"
        hover-class="pressing"
        data-id="{{item._id}}"
        bindtap="goAnnounce"
      >
        <view class="cell__body">
          <view class="cell__title">{{item.title}}</view>
        </view>
        <text class="cell__chevron">›</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    <text class="empty__emoji">🏆</text>
    赛事不存在或已下架
  </view>

  <!-- 底部操作 -->
  <view wx:if="{{detail}}" class="footer">
    <view wx:if="{{isTeacher}}" class="btn btn-plain pressable" hover-class="pressing" bindtap="goManage">赛事维护</view>
    <view
      class="btn btn-block {{following ? 'btn-plain' : 'btn-student'}} pressable"
      hover-class="pressing"
      bindtap="toggleFollow"
    >{{following ? '已关注' : '关注赛事'}}</view>
  </view>
</view>

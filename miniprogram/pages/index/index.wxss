/* 首页：常用操作与公告 */
.index-page { padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }
.hero .flex-between { gap: var(--space-sm); align-items: flex-start; }
.hero__role { flex-shrink: 0; margin-top: 10rpx; padding: 6rpx 16rpx; border-radius: var(--radius-sm); font-size: var(--font-micro); color: var(--text-secondary); background: var(--bg-block); }
.guide { display: flex; align-items: center; gap: var(--space-md); margin: var(--space-md) var(--space-lg) 0; padding: var(--space-md) var(--space-lg); min-height: 104rpx; background: var(--bg-card); border-radius: var(--radius-lg); }
.guide__body { flex: 1; min-width: 0; }
.guide__title { font-size: var(--font-body); font-weight: 500; }
.guide__go { flex-shrink: 0; font-size: var(--font-caption); color: var(--color-primary); }
.quick { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-sm); margin: 0 var(--space-lg); }
.quick__item { display: flex; align-items: center; gap: var(--space-sm); min-height: 120rpx; padding: var(--space-md); border-radius: var(--radius-lg); background: var(--bg-card); }
.quick__icon { width: 56rpx; flex-shrink: 0; text-align: center; font-size: 44rpx; color: var(--color-primary); font-weight: 400; }
.quick__icon-image { width: 56rpx; height: 56rpx; flex-shrink: 0; }
.quick__text { min-width: 0; font-size: var(--font-body); font-weight: 500; }
.todo { display: flex; align-items: center; gap: var(--space-md); margin: var(--space-md) var(--space-lg) 0; padding: var(--space-md) var(--space-lg); background: var(--bg-card); border-radius: var(--radius-lg); }
.todo__num { min-width: 56rpx; font-size: var(--font-title); font-weight: 560; color: var(--color-primary); }
.todo__body { flex: 1; min-width: 0; }
.todo__title { font-size: var(--font-body); }
.todo__arrow { font-size: 40rpx; color: var(--text-tertiary); }
.group__title--row { display: flex; align-items: center; justify-content: space-between; }
.group__more { display: inline-flex; align-items: center; min-height: 88rpx; font-size: var(--font-caption); color: var(--color-primary); }
.anno__top { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-bottom: var(--space-xs); }
.anno__title { font-size: var(--font-body); font-weight: 500; line-height: 1.5; }

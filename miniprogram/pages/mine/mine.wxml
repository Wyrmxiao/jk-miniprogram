<view class="page" bindtap="onTapFx">
  <!-- 方向 A 光斑背景 -->
  <view class="blobs">
    <view class="blob blob--1"></view>
    <view class="blob blob--2"></view>
    <view class="blob blob--3"></view>
  </view>
  <view class="hero"><view class="hero__title">我的</view></view>
  <!-- 个人信息卡：点击进入个人主页（可分享） -->
  <view class="profile pressable" hover-class="pressing" bindtap="goProfile">
    <view class="profile__avatar">{{profile && profile.realName ? profile.realName[0] : (profile ? '同' : '客')}}</view>
    <view wx:if="{{profile}}" class="profile__info">
      <view class="profile__name">{{profile.realName || profile.nickname || '未填写姓名'}}</view>
      <view class="profile__meta">
        <text class="tag {{isTeacher ? 'tag-primary' : 'tag-success'}}">{{roleText}}</text>
        <text class="tag {{isVerified ? 'tag-success' : 'tag-warning'}}">{{authStatusText}}</text>
      </view>
      <view wx:if="{{profile.studentId}}" class="profile__id">学号 {{profile.studentId}}</view>
    </view>
    <view wx:else class="profile__info">
      <view class="profile__name">未登录</view>
      <view class="profile__meta">点击使用微信登录</view>
    </view>
    <text class="cell__chevron">›</text>
  </view>

  <!-- 资料完善引导（学生认证 / 教师完善资料） -->
  <view wx:if="{{profile && !isVerified}}" class="group">
    <view class="cell pressable" hover-class="pressing" bindtap="goRealname">
      <view class="cell__body">
        <view class="cell__title">{{isTeacher ? '完善个人资料' : '学号实名认证'}}</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
  </view>

  <!-- 我关注的赛事（登录即可查看）：不点时前三个叠放，点击展开全部 -->
  <view wx:if="{{isLogin}}" class="group">
    <view class="group__title">我关注的赛事</view>
    <view wx:if="{{myContests.length === 0}}" class="cell pressable" hover-class="pressing" bindtap="goContest">
      <view class="cell__body">
        <view class="cell__title">还没有关注赛事</view>
        <view class="cell__desc">去赛事库关注赛事</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>

    <!-- 折叠态：最上面一张完整展示，后面两张露出边缘形成叠放 -->
    <view wx:elif="{{!contestsExpanded}}" class="race-stack-wrap" bindtap="toggleContests">
      <view class="race-stack pressable" hover-class="pressing">
        <view wx:if="{{myContests.length > 2}}" class="race-stack__layer race-stack__layer--3"></view>
        <view wx:if="{{myContests.length > 1}}" class="race-stack__layer race-stack__layer--2"></view>
        <view class="race-stack__top">
          <view class="my-race__top">
            <text class="my-race__name text-2lines">{{myContests[0].name}}</text>
            <text class="level level--{{myContests[0].level}}">{{myContests[0].level}}类</text>
          </view>
          <view class="cell__desc">
            <text class="tag {{myContests[0].statusClass}}">{{myContests[0].statusText}}</text>
            <text>{{myContests[0].timeText}}</text>
          </view>
        </view>
      </view>
      <view class="race-stack__hint">共 {{myContests.length}} 项关注 · 点按展开 ▾</view>
    </view>

    <!-- 展开态：全部赛事 + 收起 -->
    <block wx:else>
      <view wx:for="{{myContests}}" wx:key="_id" class="cell pressable" hover-class="pressing"
        data-id="{{item.competitionId}}" bindtap="goContestDetail">
        <view class="cell__body">
          <view class="my-race__top">
            <text class="my-race__name text-2lines">{{item.name}}</text>
            <text class="level level--{{item.level}}">{{item.level}}类</text>
          </view>
          <view class="cell__desc">
            <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
            <text>{{item.timeText}}</text>
          </view>
        </view>
        <text class="cell__chevron">›</text>
      </view>
      <view class="race-stack__collapse pressable" hover-class="pressing" bindtap="toggleContests">收起</view>
    </block>
  </view>

  <!-- 赛事统计：点击进入详情页（个人主页） -->
  <view wx:if="{{isLogin}}" class="group">
    <view class="cell pressable" hover-class="pressing" bindtap="goMyStats">
      <view class="cell__body">
        <view class="cell__title">赛事统计</view>
        <view class="cell__desc">正在准备的比赛 · 参加过的比赛</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
  </view>

  <!-- 学生学习入口 -->
  <view wx:if="{{isLogin && !isTeacher}}" class="group">
    <view class="cell pressable" hover-class="pressing" bindtap="goWeeklyReport">
      <view class="cell__body">
        <view class="cell__title">每周学习汇报</view>
        <view class="cell__desc">记录知识点、重难点与疑问，可附博客链接</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
    <view class="cell pressable" hover-class="pressing" bindtap="goClasses">
      <view class="cell__body">
        <view class="cell__title">我的班级</view>
        <view class="cell__desc">加入班级后可向本班提交汇报</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
  </view>

  <!-- 教师工作台 -->
  <view wx:if="{{isTeacher}}" class="group">
    <view class="group__title">教师工作台</view>
    <view class="cell pressable" hover-class="pressing" bindtap="goPublishAnnounce">
      <view class="cell__body">
        <view class="cell__title">发布公告</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
    <view class="cell pressable" hover-class="pressing" bindtap="goPublishTask">
      <view class="cell__body">
        <view class="cell__title">布置任务</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
    <view class="cell pressable" hover-class="pressing" bindtap="goClasses">
      <view class="cell__body">
        <view class="cell__title">我的班级</view>
        <view class="cell__desc">创建班级 · 生成邀请码 / 二维码</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
    <view class="cell pressable" hover-class="pressing" bindtap="goReportCollect">
      <view class="cell__body">
        <view class="cell__title">每周汇报收集</view>
        <view class="cell__desc">按班级 + 周次查看提交情况 · 导出 Excel</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
    <view class="cell pressable" hover-class="pressing" bindtap="goManageContest">
      <view class="cell__body">
        <view class="cell__title">赛事维护</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
    <view class="cell pressable" hover-class="pressing" bindtap="goRealname">
      <view class="cell__body">
        <view class="cell__title">认证审核</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
    <view class="cell pressable" hover-class="pressing" bindtap="goMyAnnouncements">
      <view class="cell__body">
        <view class="cell__title">我的公告</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
  </view>

  <!-- 系统管理（管理员） -->
  <view wx:if="{{isAdmin}}" class="group">
    <view class="group__title">系统管理</view>
    <view class="cell">
      <view class="cell__body">
        <view class="cell__title">系统状态</view>
        <view class="cell__desc">竞赛库 {{systemStatus.competitions || 0}} 项 · {{systemStatus.initialized ? '已初始化' : '未初始化'}}</view>
      </view>
    </view>
    <view class="cell pressable" hover-class="pressing" bindtap="rerunInit">
      <view class="cell__body">
        <view class="cell__title">系统初始化</view>
        <view class="cell__desc">建配置与指定管理员</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
    <view class="cell pressable" hover-class="pressing" bindtap="forceReseed">
      <view class="cell__body">
        <view class="cell__title">重导竞赛库</view>
        <view class="cell__desc">按 83 号文覆盖导入</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
    <view class="cell pressable" hover-class="pressing" bindtap="goUsers">
      <view class="cell__body">
        <view class="cell__title">用户与权限</view>
        <view class="cell__desc">查看全部用户，分配学生 / 教师 / 管理员</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
    <view class="cell cell--dot pressable" hover-class="pressing" bindtap="goFeedbackManage">
      <view class="cell__icon cell__icon--purple">💬</view>
      <view class="cell__body">
        <view class="cell__title">反馈管理</view>
        <view class="cell__desc">开发团队处理小程序问题反馈</view>
      </view>
      <view wx:if="{{fbManageDot}}" class="fb-dot"></view>
      <text class="cell__chevron">›</text>
    </view>
  </view>

  <!-- 通用 -->
  <view class="group">
    <view wx:if="{{!isAdmin}}" class="cell cell--dot pressable" hover-class="pressing" bindtap="goFeedback">
      <view class="cell__icon cell__icon--blue">💬</view>
      <view class="cell__body">
        <view class="cell__title">意见反馈</view>
        <view class="cell__desc">提交问题或建议，开发团队会回复</view>
      </view>
      <view wx:if="{{fbSubmitDot}}" class="fb-dot"></view>
      <text class="cell__chevron">›</text>
    </view>
    <view class="cell pressable" hover-class="pressing" bindtap="goAgreement">
      <view class="cell__body">
        <view class="cell__title">用户隐私保护指引</view>
      </view>
      <text class="cell__chevron">›</text>
    </view>
  </view>

  <!-- ===== 我的公告（全屏页） ===== -->
  <view wx:if="{{showMyAnnounce}}" class="anno-page">
    <view class="anno-page__header">
      <text class="anno-page__back" bindtap="closeMyAnnounce">‹ 返回</text>
      <text class="anno-page__title">我发布的公告</text>
      <text class="anno-page__count">{{myAnnouncements.length}} 条</text>
    </view>
    <scroll-view scroll-y class="anno-page__body">
      <view wx:for="{{myAnnouncements}}" wx:key="_id" class="anno-page__card">
        <view class="anno-page__card-top">
          <text class="tag tag-primary">{{item.type === 'contest' ? '赛事' : '通知'}}</text>
          <text class="anno-page__time">{{item.createdAtText || item.createdAt}}</text>
        </view>
        <view class="anno-page__card-title">{{item.title}}</view>
        <view class="anno-page__card-foot">
          <text class="anno-page__del" data-id="{{item._id}}" bindtap="removeAnnounce">删除</text>
        </view>
      </view>
      <view wx:if="{{!myAnnouncements.length}}" class="empty">还没有发布过公告</view>
    </scroll-view>
  </view>
  <tap-ripple id="tapFx" />
</view>

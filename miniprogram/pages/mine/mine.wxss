/* pages/mine/mine.wxss —— Apple 风格「我的」 */
.page { background: transparent; padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }

/* ===== 我发布的公告 · 全屏页 ===== */
.anno-page {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
  z-index: 1300; /* 高于 tabBar(200)、AI 悬浮球(1000)、tap-ripple(999) */
  background: var(--bg-page-grad);
  display: flex;
  flex-direction: column;
}
.anno-page__header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: calc(var(--space-lg) + env(safe-area-inset-top)) var(--space-lg) var(--space-md);
  background: var(--bg-elevated);
  border-bottom: 1rpx solid var(--border-light);
}
.anno-page__back { width: 120rpx; font-size: var(--font-body); color: var(--color-primary); }
.anno-page__title { flex: 1; text-align: center; font-size: var(--font-headline); font-weight: 620; color: var(--text-primary); }
.anno-page__count { width: 120rpx; text-align: right; font-size: var(--font-caption); color: var(--text-tertiary); }
.anno-page__body {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  width: 100%;
  padding: var(--space-md) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
}
.anno-page__card {
  box-sizing: border-box;
  width: 100%;
  background: var(--bg-elevated);
  border-radius: var(--radius-md);
  padding: var(--space-md) var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: 0 8rpx 32rpx rgba(30, 42, 90, 0.06);
}
.anno-page__card-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); min-width: 0; }
.anno-page__time { flex-shrink: 0; font-size: var(--font-caption); color: var(--text-tertiary); white-space: nowrap; }
.anno-page__card-title { margin-top: var(--space-sm); font-size: var(--font-body); color: var(--text-primary); line-height: 1.5; word-break: break-all; }
.anno-page__card-foot { margin-top: var(--space-sm); text-align: right; }
.anno-page__del { font-size: var(--font-caption); color: var(--color-danger); padding: var(--space-sm); }

/* ===== 意见反馈红点（cell 右上角小圆点） ===== */
.cell--dot { position: relative; }
.fb-dot {
  position: absolute;
  top: 16rpx;
  right: 56rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #fa5151;
}

/* ===== 个人信息卡 ===== */
.profile {
  display: flex;
  align-items: center;
  margin: var(--space-md) var(--space-lg) 0;
  padding: var(--space-lg);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.profile__avatar {
  width: 112rpx;
  height: 112rpx;
  margin-right: var(--space-lg);
  border-radius: 50%;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-title);
  font-weight: 560;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.profile__info { flex: 1; min-width: 0; }
.profile__name { font-size: var(--font-headline); font-weight: 560; color: var(--text-primary); }
.profile__meta { display: flex; flex-direction: row; align-items: center; margin-top: var(--space-sm); flex-wrap: wrap; }
.profile__meta .tag { margin-right: var(--space-sm); }
.profile__id { margin-top: var(--space-sm); font-size: var(--font-caption); color: var(--text-secondary); }

/* ===== 分组列表图标 ===== */
/* ===== 我的公告 ===== */
.anno-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) 0;
  border-bottom: 2rpx solid var(--border-light);
}
.anno-row:last-child { border-bottom: none; }
.anno-row__info { flex: 1; min-width: 0; }
.anno-row__title { display: flex; flex-direction: row; align-items: center; font-size: var(--font-body); color: var(--text-primary); }
.anno-row__title .tag { margin-right: var(--space-sm); }
.anno-row__meta { margin-top: 6rpx; font-size: var(--font-caption); color: var(--text-secondary); }
.anno-row__del { font-size: var(--font-caption); color: var(--color-danger); padding: var(--space-sm); }

/* ===== 我关注的赛事 ===== */
.my-race__top { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
.my-race__name { flex: 1; min-width: 0; font-size: var(--font-body); font-weight: 500; color: var(--text-primary); line-height: 1.5; margin-right: var(--space-sm); }
.my-race__top .level { flex-shrink: 0; }

/* ===== 关注赛事叠放卡（折叠态） ===== */
.race-stack-wrap { margin: var(--space-sm) var(--space-lg) 0; }
.race-stack {
  position: relative;
  padding-top: 30rpx; /* 给露出的背后卡片留出空间 */
}
.race-stack__layer {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 12rpx;
  bottom: 10rpx;
  border-radius: 24rpx;
  background: var(--bg-elevated);
  border: 2rpx solid var(--border-light);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
  z-index: 0;
}
.race-stack__layer--2 { opacity: 0.75; }
.race-stack__layer--3 { top: 2rpx; left: 26rpx; right: 26rpx; opacity: 0.45; }
.race-stack__top {
  position: relative;
  z-index: 1;
  padding: var(--space-md);
  border-radius: 24rpx;
  background: var(--bg-elevated);
  border: 2rpx solid var(--border-light);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
}
.race-stack__hint {
  margin-top: 14rpx;
  text-align: center;
  font-size: var(--font-micro);
  color: var(--text-tertiary);
  letter-spacing: var(--tracking-normal);
}
.race-stack__collapse {
  margin: var(--space-sm) var(--space-lg) 0;
  padding: 20rpx;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--text-secondary);
  background: var(--bg-elevated);
  border: 2rpx dashed var(--border-light);
  border-radius: 24rpx;
}

.cell__desc .tag { margin-right: var(--space-sm); }

/* ===== 赛事统计 ===== */
.group__title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-lg) var(--space-lg) var(--space-sm);
}
.group__title-row .group__title { padding: 0; }
.group__action {
  font-size: var(--font-caption);
  color: var(--color-primary);
  font-weight: 560;
  padding: 8rpx 0 8rpx var(--space-md);
}
.cell--head { min-height: 72rpx; padding-top: var(--space-sm); padding-bottom: 0; }
.cell--head + .cell::before { display: none; }
.stat-sub { font-size: var(--font-caption); color: var(--text-tertiary); font-weight: 560; letter-spacing: var(--tracking-normal); }
.stat-sub__count {
  margin-left: 10rpx;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-block);
  color: var(--text-secondary);
  font-size: var(--font-micro);
}

/* pages/mine/mine.wxss —— Apple 风格「我的」 */
.page { background: transparent; padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }

/* ===== 个人信息卡 ===== */
.profile {
  display: flex;
  align-items: center;
  margin: var(--space-md) var(--space-lg) 0;
  padding: var(--space-lg);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.profile__avatar {
  width: 112rpx;
  height: 112rpx;
  margin-right: var(--space-lg);
  border-radius: 50%;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-title);
  font-weight: 560;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.profile__info { flex: 1; min-width: 0; }
.profile__name { font-size: var(--font-headline); font-weight: 560; color: var(--text-primary); }
.profile__meta { display: flex; flex-direction: row; align-items: center; margin-top: var(--space-sm); flex-wrap: wrap; }
.profile__meta .tag { margin-right: var(--space-sm); }
.profile__id { margin-top: var(--space-sm); font-size: var(--font-caption); color: var(--text-secondary); }

/* ===== 分组列表图标 ===== */
/* ===== 我的公告 ===== */
.anno-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) 0;
  border-bottom: 2rpx solid var(--border-light);
}
.anno-row:last-child { border-bottom: none; }
.anno-row__info { flex: 1; min-width: 0; }
.anno-row__title { display: flex; flex-direction: row; align-items: center; font-size: var(--font-body); color: var(--text-primary); }
.anno-row__title .tag { margin-right: var(--space-sm); }
.anno-row__meta { margin-top: 6rpx; font-size: var(--font-caption); color: var(--text-secondary); }
.anno-row__del { font-size: var(--font-caption); color: var(--color-danger); padding: var(--space-sm); }

/* ===== 我关注的赛事 ===== */
.my-race__top { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
.my-race__name { flex: 1; min-width: 0; font-size: var(--font-body); font-weight: 500; color: var(--text-primary); line-height: 1.5; margin-right: var(--space-sm); }
.my-race__top .level { flex-shrink: 0; }
.cell__desc .tag { margin-right: var(--space-sm); }

/* ===== 赛事统计 ===== */
.group__title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-lg) var(--space-lg) var(--space-sm);
}
.group__title-row .group__title { padding: 0; }
.group__action {
  font-size: var(--font-caption);
  color: var(--color-primary);
  font-weight: 560;
  padding: 8rpx 0 8rpx var(--space-md);
}
.cell--head { min-height: 72rpx; padding-top: var(--space-sm); padding-bottom: 0; }
.cell--head + .cell::before { display: none; }
.stat-sub { font-size: var(--font-caption); color: var(--text-tertiary); font-weight: 560; letter-spacing: var(--tracking-normal); }
.stat-sub__count {
  margin-left: 10rpx;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-block);
  color: var(--text-secondary);
  font-size: var(--font-micro);
}

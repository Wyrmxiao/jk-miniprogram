/* 方向 A · Liquid Glass 悬浮层 — 通用组件 */

/* ===== 布局工具 ===== */
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; min-width: 0; }
.flex-between { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.flex-center { display: flex; flex-direction: row; align-items: center; justify-content: center; }
.flex-wrap { flex-wrap: wrap; }

/* ===== 页面容器：渐变底 + 光斑 ===== */
/* 注意：不能用 overflow:hidden，否则会裁掉超过一屏的页面内容。
   光斑是 position:fixed，本身不需要父级裁剪。 */
.page {
  position: relative;
  min-height: 100vh;
  background: var(--bg-page-grad);
  padding-bottom: calc(var(--space-xl) + 160rpx + env(safe-area-inset-bottom));
}

/* ===== 光斑（方向 A 的灵魂：三个彩色圆缓慢漂移） ===== */
.blobs {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}
.blob {
  position: absolute;
  border-radius: 50%;
  will-change: transform;
}
/* 不用 filter: blur —— 安卓兼容性差且耗性能。
   radial-gradient 本身边缘就是柔和过渡，够用。 */
.blob--1 {
  top: -160rpx; left: -120rpx;
  width: 560rpx; height: 560rpx;
  background: radial-gradient(circle at 35% 35%, rgba(88,120,255,0.42), rgba(88,120,255,0) 68%);
  animation: blobDrift1 19s ease-in-out infinite;
}
.blob--2 {
  top: 220rpx; right: -180rpx;
  width: 580rpx; height: 580rpx;
  background: radial-gradient(circle at 50% 50%, rgba(186,124,255,0.34), rgba(186,124,255,0) 66%);
  animation: blobDrift2 23s ease-in-out infinite;
}
.blob--3 {
  bottom: 80rpx; left: 60rpx;
  width: 520rpx; height: 520rpx;
  background: radial-gradient(circle at 50% 50%, rgba(90,220,200,0.28), rgba(90,220,200,0) 66%);
  animation: blobDrift1 27s ease-in-out infinite reverse;
}
@keyframes blobDrift1 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(90rpx, -56rpx) scale(1.12); }
}
@keyframes blobDrift2 {
  0%, 100% { transform: translate(0, 0) scale(1.05); }
  50% { transform: translate(-76rpx, 50rpx) scale(0.92); }
}

/* ===== 按压反馈 ===== */
.pressable {
  transition: transform var(--duration-press) var(--ease-spring),
              opacity var(--duration-press) ease;
}
.pressable.pressing {
  transform: scale(0.96);
  opacity: 0.85;
}

/* ===== 进场动效 ===== */
@keyframes riseIn {
  from { opacity: 0; transform: translateY(36rpx) scale(0.97); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.rise { animation: riseIn var(--duration-spring) var(--ease-spring) both; }
.rise--1 { animation-delay: 60ms; }
.rise--2 { animation-delay: 120ms; }
.rise--3 { animation-delay: 180ms; }
.rise--4 { animation-delay: 240ms; }

/* ===== 玻璃卡片（方向 A 核心） ===== */
.card {
  position: relative;
  background: var(--bg-card);
  -webkit-backdrop-filter: blur(28px) saturate(180%);
  backdrop-filter: blur(28px) saturate(180%);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  margin: var(--space-md) var(--space-lg);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--shadow-card);
  animation: riseIn var(--duration-spring) var(--ease-spring) both;
}
.card-flat {
  background: var(--bg-card);
  -webkit-backdrop-filter: blur(28px) saturate(180%);
  backdrop-filter: blur(28px) saturate(180%);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  border: 1rpx solid var(--glass-border);
}
/* 强玻璃：用于重要卡片 */
.card--strong {
  background: var(--bg-card-strong);
  box-shadow: var(--shadow-soft);
}

/* ===== 分组列表 ===== */
.group {
  margin: var(--space-md) var(--space-lg) var(--space-lg);
  background: var(--bg-card);
  -webkit-backdrop-filter: blur(28px) saturate(180%);
  backdrop-filter: blur(28px) saturate(180%);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  animation: riseIn var(--duration-spring) var(--ease-spring) both;
}
.group__title {
  font-size: var(--font-headline);
  font-weight: 620;
  letter-spacing: var(--tracking-title);
  color: var(--text-primary);
  padding: var(--space-lg) var(--space-lg) var(--space-sm);
}
.cell {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: var(--space-md) var(--space-lg);
}
.cell + .cell::before {
  content: '';
  position: absolute;
  left: var(--space-lg); right: 0; top: 0;
  height: 1rpx;
  background: var(--border-light);
}
.cell__body { flex: 1; min-width: 0; }
.cell__title { font-size: var(--font-body); color: var(--text-primary); font-weight: 540; letter-spacing: var(--tracking-normal); }
.cell__desc { margin-top: 4rpx; font-size: var(--font-caption); color: var(--text-secondary); line-height: var(--leading-body); letter-spacing: var(--tracking-normal); }
.cell__chevron { margin-left: var(--space-sm); font-size: 32rpx; color: var(--text-tertiary); }
.cell__value { font-size: var(--font-caption); color: var(--text-secondary); margin-left: var(--space-sm); }

/* ===== 分段控件 ===== */
.seg {
  display: flex;
  margin: var(--space-md) var(--space-lg) var(--space-sm);
  padding: 6rpx;
  background: var(--bg-block);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--glass-border);
}
.seg__item {
  flex: 1;
  min-height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--text-secondary);
  border-radius: var(--radius-sm);
  letter-spacing: var(--tracking-normal);
  transition: all var(--duration-normal) var(--ease-spring);
}
.seg__item:active { transform: scale(0.95); }
.seg__item--on {
  background: var(--bg-card-strong);
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(59, 91, 255, 0.12);
}

/* ===== 大标题头部 ===== */
.hero {
  position: relative;
  z-index: 1;
  padding: var(--space-lg) var(--space-lg) var(--space-sm);
  animation: riseIn var(--duration-spring) var(--ease-spring) both;
}
/* 大标题：用深色实心。
   不能用 background-clip: text 做渐变字——部分安卓基础库不支持，
   会导致 color: transparent 生效但渐变不渲染，标题直接消失。 */
.hero__title {
  min-width: 0;
  font-size: var(--font-large);
  font-weight: 760;
  color: var(--text-primary);
  line-height: var(--leading-title);
  letter-spacing: var(--tracking-title);
  overflow-wrap: break-word;
}
.hero__sub { margin-top: var(--space-xs); font-size: var(--font-caption); color: var(--text-secondary); line-height: var(--leading-normal); letter-spacing: var(--tracking-normal); }
.hero__search {
  margin-top: var(--space-md);
  height: 88rpx;
  padding: 0 var(--space-md);
  border-radius: var(--radius-pill);
  background: var(--bg-card);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  border: 1rpx solid var(--glass-border);
  font-size: var(--font-body);
  color: var(--text-primary);
}
.hero__ph { color: var(--text-tertiary); }
.hero__row { display: flex; gap: var(--space-sm); align-items: center; justify-content: space-between; }
.hero__btns { display: flex; flex-wrap: wrap; gap: var(--space-xs); align-items: center; }
.hero__manage {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 var(--space-sm);
  color: var(--color-primary);
  flex-shrink: 0;
  font-size: var(--font-caption);
}
.hero__back { display: flex; align-items: center; min-height: 88rpx; color: var(--color-primary); font-size: var(--font-body); }

/* ===== 按钮：渐变 + 胶囊 ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0 var(--space-xl);
  border-radius: var(--radius-pill);
  font-size: var(--font-body);
  font-weight: 620;
  letter-spacing: var(--tracking-normal);
  background: var(--color-accent-grad);
  color: var(--text-inverse);
  box-shadow: 0 12rpx 36rpx rgba(59, 91, 255, 0.28);
  transition: transform var(--duration-press) var(--ease-spring), opacity var(--duration-press) ease, box-shadow var(--duration-press) ease;
}
.btn:active {
  transform: scale(0.95);
  opacity: 0.9;
  box-shadow: 0 6rpx 20rpx rgba(59, 91, 255, 0.2);
}
.btn-ghost {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 580;
  box-shadow: none;
}
.btn-ghost:active { box-shadow: none; }
.btn-plain {
  background: var(--bg-card);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  border: 1rpx solid var(--glass-border);
  color: var(--color-primary);
  font-weight: 580;
  box-shadow: none;
}
.btn-danger {
  background: var(--color-danger-light);
  color: var(--color-danger);
  font-weight: 580;
  box-shadow: none;
}
.btn-student { background: var(--color-accent-grad); color: #fff; }
.btn-disabled { opacity: 0.45; box-shadow: none; }
.btn-block { width: 100%; }

/* ===== 底部弹层 ===== */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 100;
  background: rgba(14, 14, 18, 0.32);
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: flex-end;
}
.sheet {
  position: relative;
  width: 100%;
  max-height: 84vh;
  overflow-y: auto;
  background: var(--bg-elevated);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  backdrop-filter: blur(40px) saturate(180%);
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  padding: 16rpx var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
}
.sheet__grip {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 8rpx;
  background: var(--border-color);
}
.sheet__title { font-size: var(--font-headline); font-weight: 620; color: var(--text-primary); letter-spacing: var(--tracking-title); }
.sheet__tip { margin-top: 8rpx; font-size: var(--font-caption); color: var(--text-secondary); line-height: var(--leading-normal); letter-spacing: var(--tracking-normal); }
.sheet__close {
  position: absolute;
  top: var(--space-md);
  right: var(--space-lg);
  font-size: 36rpx;
  color: var(--text-tertiary);
}
.sheet__list { max-height: 60vh; }

/* ===== 表单控件 ===== */
.field {
  margin-top: var(--space-md);
  height: 88rpx;                 /* 显式给高度，不再靠 padding 撑 */
  line-height: 88rpx;            /* 让文字垂直居中 */
  padding: 0 var(--space-md);    /* 上下内边距归零，左右保留 */
  border-radius: var(--radius-md);
  background: var(--bg-card);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  border: 1rpx solid var(--glass-border);
  font-size: var(--font-body);
  color: var(--text-primary);
}
input.field { height: 96rpx; line-height: 96rpx; padding: 0 var(--space-md); }
.field--area {
  height: auto;                  /* 多行输入要放回自动高度 */
  min-height: 160rpx;
  line-height: 1.6;              /* 行距恢复正常 */
  padding: 20rpx var(--space-md);/* 多行的上下内边距要留 */
  width: auto;
}
.row { display: flex; align-items: center; margin-top: var(--space-lg); }
.row__label { flex-shrink: 0; font-size: var(--font-body); color: var(--text-secondary); margin-right: var(--space-md); font-weight: 520; letter-spacing: var(--tracking-normal); }
.opts { display: flex; flex-wrap: wrap; }
.opt {
  display: inline-flex;
  align-items: center;
  min-height: 80rpx;
  padding: 12rpx 32rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: var(--radius-pill);
  background: var(--bg-card);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  border: 1rpx solid var(--glass-border);
  font-size: var(--font-caption);
  color: var(--text-secondary);
  letter-spacing: var(--tracking-normal);
  transition: all var(--duration-normal) var(--ease-spring);
}
.opt:active { transform: scale(0.93); }
.opt--on {
  background: var(--color-primary-light);
  border-color: rgba(59, 91, 255, 0.25);
  color: var(--color-primary);
  font-weight: 600;
}
.picker {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 12rpx var(--space-md);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  border: 1rpx solid var(--glass-border);
  font-size: var(--font-caption);
}
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-lg);
  font-size: var(--font-body);
  color: var(--text-secondary);
}
.switch-row__desc { margin-top: 6rpx; font-size: var(--font-micro); color: var(--text-tertiary); }

/* ===== 标签 / 徽章 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-micro);
  background: var(--bg-card);
  border: 1rpx solid var(--glass-border);
  color: var(--text-secondary);
}
.tag-primary { background: var(--color-primary-light); border-color: rgba(59,91,255,0.2); color: var(--color-primary); }
.tag-success { background: var(--color-success-light); border-color: transparent; color: var(--color-success); }
.tag-warning { background: var(--color-warning-light); border-color: transparent; color: var(--color-warning); }
.tag-danger  { background: var(--color-danger-light);  border-color: transparent; color: var(--color-danger); }

.badge {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-micro);
  background: var(--bg-card);
  border: 1rpx solid var(--glass-border);
  color: var(--text-secondary);
}
.badge--todo { background: var(--bg-card); color: var(--text-secondary); }
.badge--submitted { background: var(--color-primary-light); color: var(--color-primary); }
.badge--reviewed { background: var(--color-success-light); color: var(--color-success); }
.badge--returned { background: var(--color-danger-light); color: var(--color-danger); }

/* ===== 竞赛级别 ===== */
.level {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-micro);
  font-weight: 600;
  letter-spacing: var(--tracking-normal);
}
.level--A { background: var(--color-danger-light); color: var(--level-a); }
.level--B { background: var(--color-warning-light); color: var(--level-b); }
.level--C { background: var(--color-primary-light); color: var(--level-c); }
.level--D { background: var(--bg-block); color: var(--level-d); }

/* ===== 状态与空态 ===== */
.state-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--text-secondary);
  font-size: var(--font-caption);
}
.state-empty__icon { width: 160rpx; height: 160rpx; margin-bottom: var(--space-md); opacity: 0.5; }
.empty { padding: 80rpx 0; text-align: center; color: var(--text-secondary); font-size: var(--font-caption); }
.empty__emoji { display: block; font-size: 72rpx; margin-bottom: var(--space-sm); }

/* ===== 区块标题 ===== */
.section-title {
  font-size: var(--font-headline);
  font-weight: 620;
  color: var(--text-primary);
  letter-spacing: var(--tracking-title);
  padding: var(--space-lg) var(--space-lg) var(--space-sm);
}

/* ===== 骨架屏 ===== */
.skeleton {
  background: linear-gradient(90deg, rgba(232,236,244,0.6) 25%, rgba(240,242,250,0.8) 37%, rgba(232,236,244,0.6) 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
  border-radius: var(--radius-sm);
}
@keyframes skeleton-loading {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* ===== 安全区与文字 ===== */
.safe-bottom { padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom)); }
.text-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.text-2lines {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.divider { height: 2rpx; background: var(--border-light); }
.gap-sm { height: var(--space-sm); }
.gap-md { height: var(--space-md); }

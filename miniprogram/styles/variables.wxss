/* 方向 A · Liquid Glass 悬浮层 — 设计令牌 */
page {
  /* ===== A 的核心色 ===== */
  --color-primary: #3B5BFF;
  --color-primary-light: rgba(59, 91, 255, 0.10);
  --color-primary-dark: #2A45E0;
  --color-accent-grad: linear-gradient(135deg, #3B5BFF 0%, #7C5CFF 58%, #A855F7 100%);
  --color-purple: #7C5CFF;
  --color-violet: #A855F7;

  /* ===== 状态色 ===== */
  --color-success: #248a3d;
  --color-success-light: #edf8ef;
  --color-warning: #f59e0b;
  --color-warning-light: #fffbeb;
  --color-danger: #ef4444;
  --color-danger-light: #fef2f2;
  --color-info: #8b5cf6;
  --color-info-light: #f5f3ff;

  /* ===== 兼容角色控件 ===== */
  --color-student: var(--color-primary);
  --color-student-deep: var(--color-primary-dark);
  --color-teacher: var(--color-primary);
  --color-teacher-deep: var(--color-primary-dark);

  /* ===== 竞赛级别 ===== */
  --level-a: var(--color-danger);
  --level-b: var(--color-warning);
  --level-c: var(--color-primary);
  --level-d: #9ca3af;

  /* ===== 文字 ===== */
  --text-primary: #0E0E12;
  --text-secondary: #5C5C68;
  --text-tertiary: #9A9AA6;
  --text-quaternary: var(--text-tertiary);
  --text-inverse: #ffffff;

  /* ===== 背景 ===== */
  --bg-page: #F7F8FC;
  --bg-page-grad: linear-gradient(180deg, #F7F8FC 0%, #F2F3FA 100%);
  --bg-card: rgba(255, 255, 255, 0.52);
  --bg-card-strong: rgba(255, 255, 255, 0.74);
  --bg-block: rgba(255, 255, 255, 0.38);
  --bg-elevated: rgba(255, 255, 255, 0.88);
  --glass-bg: rgba(255, 255, 255, 0.52);
  --glass-border: rgba(255, 255, 255, 0.92);
  --border-color: rgba(210, 212, 225, 0.5);
  --border-light: rgba(255, 255, 255, 0.85);

  /* ===== 间距 ===== */
  --space-xs: 8rpx;
  --space-sm: 18rpx;
  --space-md: 28rpx;
  --space-lg: 36rpx;
  --space-xl: 56rpx;

  /* ===== 字阶 ===== */
  --font-micro: 22rpx;
  --font-caption: 28rpx;
  --font-body: 32rpx;
  --font-headline: 40rpx;
  --font-title: 54rpx;
  --font-large: 72rpx;
  --font-display: 92rpx;

  /* ===== 字距 ===== */
  --tracking-normal: 0.6rpx;
  --tracking-title: 1.5rpx;
  --tracking-wide: 3rpx;

  /* ===== 行高 ===== */
  --leading-title: 1.18;
  --leading-normal: 1.6;
  --leading-body: 1.8;
  --leading-compact: 1.35;

  /* ===== 圆角 ===== */
  --radius-sm: 22rpx;
  --radius-md: 36rpx;
  --radius-lg: 52rpx;
  --radius-sheet: 60rpx;
  --radius-pill: 999rpx;

  /* ===== A 的阴影：内高光 + 外柔影 ===== */
  --shadow-card: inset 0 2rpx 0 rgba(255,255,255,0.95), 0 16rpx 48rpx rgba(38,52,110,0.10), 0 2rpx 6rpx rgba(38,52,110,0.05);
  --shadow-soft: inset 0 2rpx 0 rgba(255,255,255,0.95), 0 12rpx 36rpx rgba(38,52,110,0.11), 0 2rpx 4rpx rgba(38,52,110,0.06);
  --shadow-float: 0 24rpx 64rpx rgba(30,42,90,0.18), 0 2rpx 0 rgba(255,255,255,.9) inset;

  /* ===== 动效 ===== */
  --ease-press: cubic-bezier(0.2, 0.8, 0.2, 1);
  --ease-spring: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --duration-press: 180ms;
  --duration-normal: 320ms;
  --duration-spring: 520ms;
}

/* pkgWork/report/list.wxss —— 教师端：周次汇总 */
.page { min-height: 100vh; background: var(--bg-page); padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }

.state { text-align: center; color: var(--text-secondary); font-size: var(--font-caption); padding: 60rpx 0; }

/* 班级切换条 */
.cls-bar {
  display: flex;
  white-space: nowrap;
  padding: var(--space-md) var(--space-lg) 0;
  box-sizing: border-box;
}
.cls-tab {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  margin-right: var(--space-xs);
  border-radius: var(--radius-pill);
  background: var(--bg-block);
  border: 1rpx solid var(--border-color);
  font-size: var(--font-caption);
  color: var(--text-secondary);
}
.cls-tab--on {
  background: var(--color-primary-light);
  border-color: rgba(59, 91, 255, 0.4);
  color: var(--color-primary);
  font-weight: 560;
}
.cls-tab--add { color: var(--text-tertiary); border-style: dashed; }

/* 无班级引导 */
.state-box {
  margin: var(--space-md) var(--space-lg);
  padding: var(--space-lg);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
}
.state-box__title { font-size: var(--font-body); font-weight: 560; color: var(--text-primary); }
.state-box__desc { margin: var(--space-sm) 0 var(--space-md); font-size: var(--font-caption); color: var(--text-secondary); line-height: 1.6; }

.actions { margin: var(--space-md) var(--space-lg) 0; }
.quick {
  display: flex;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  border-radius: var(--radius-lg);
  background: var(--color-primary-light);
  border: 1rpx solid rgba(59, 91, 255, 0.18);
}
.quick__icon {
  font-size: 40rpx;
  color: var(--color-primary);
  margin-right: var(--space-md);
  line-height: 1;
}
.quick__body { flex: 1; min-width: 0; }
.quick__title { font-size: var(--font-body); font-weight: 560; color: var(--color-primary); }
.quick__desc { margin-top: 6rpx; font-size: var(--font-micro); color: var(--text-secondary); }

.list { margin: var(--space-md) var(--space-lg) var(--space-lg); }
.witem {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: var(--space-md) var(--space-lg);
  margin-bottom: var(--space-md);
}
.witem__head { display: flex; align-items: center; }
.witem__week { font-size: var(--font-body); font-weight: 560; color: var(--text-primary); }
.witem__count { margin-left: auto; font-size: var(--font-caption); color: var(--text-secondary); }
.witem__range { margin-top: 8rpx; font-size: var(--font-micro); color: var(--text-tertiary); }

.bar {
  margin-top: var(--space-sm);
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--bg-block);
  overflow: hidden;
}
.bar__fill { height: 100%; background: var(--color-primary); border-radius: 999rpx; }

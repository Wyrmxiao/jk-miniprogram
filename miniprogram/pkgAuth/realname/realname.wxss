/* pkgAuth/realname/realname.wxss —— Apple 风格「完善资料」页 */
.page { background: var(--bg-page); min-height: 100vh; }

/* 状态卡（ tinted 横幅 ） */
.status-card { text-align: center; padding: var(--space-xl) var(--space-lg); }
.status-card__title { font-size: var(--font-headline); font-weight: 600; color: var(--color-primary); }
.status-card--ok .status-card__title { color: var(--color-success); }
.status-card--no .status-card__title { color: var(--color-danger); }
.status-card__desc { margin-top: var(--space-sm); font-size: var(--font-caption); color: var(--text-secondary); line-height: 1.6; }

/* 表单行（inset grouped 风格） */
.form-row { margin-top: var(--space-lg); }
.form-row__label { display: block; font-size: var(--font-caption); color: var(--text-secondary); font-weight: 500; margin-bottom: var(--space-sm); }
.form-row__input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--space-md);
  border-radius: var(--radius-md);
  background: var(--bg-block);
  font-size: var(--font-body);
  color: var(--text-primary);
}

/* 待审核列表 */
.pending-wrap { margin: 0 var(--space-lg) var(--space-lg); }
.pending-item { padding: var(--space-md) 0; border-bottom: 2rpx solid var(--border-light); }
.pending-item:last-child { border-bottom: none; }
.pending-item__name { font-size: var(--font-body); color: var(--text-primary); font-weight: 500; }
.pending-item__meta { margin-top: 6rpx; font-size: var(--font-caption); color: var(--text-secondary); }
.pending-item__actions { flex-direction: row; margin-top: var(--space-md); }

.mini-btn {
  padding: 12rpx 40rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-caption);
  font-weight: 500;
  margin-right: var(--space-sm);
}
.mini-btn--ok { background: var(--color-primary); color: #fff; }
.mini-btn--no { background: var(--bg-block); color: var(--text-secondary); }

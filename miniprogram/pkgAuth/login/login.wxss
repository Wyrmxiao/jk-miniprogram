/* 登录：操作入口与隐私同意 */
.auth { padding: 120rpx var(--space-lg) calc(var(--space-xl) + env(safe-area-inset-bottom)); }
.auth__brand { text-align: center; margin-bottom: 80rpx; }
.auth__mark { width: 112rpx; height: 112rpx; margin-bottom: var(--space-md); }
.auth__logo { font-size: var(--font-large); font-weight: 650; line-height: 1.25; }
.auth__sub { margin-top: var(--space-sm); font-size: var(--font-body); color: var(--text-secondary); }
.auth__card { padding: var(--space-lg); border-radius: var(--radius-lg); background: var(--bg-card); }
.auth__title { font-size: var(--font-title); font-weight: 560; margin-bottom: var(--space-xl); }
.auth__privacy { padding: var(--space-md) 0; color: var(--color-primary); font-size: var(--font-caption); }
.auth__agree { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 4rpx; margin-top: var(--space-md); font-size: var(--font-micro); color: var(--text-secondary); }
.auth__check { display: flex; align-items: center; min-height: 88rpx; }
.auth__link { display: inline-flex; align-items: center; min-height: 88rpx; color: var(--color-primary); }

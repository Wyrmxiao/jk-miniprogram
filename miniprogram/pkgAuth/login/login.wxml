<view class="page auth">
  <view class="blobs">
    <view class="blob blob--1"></view>
    <view class="blob blob--2"></view>
    <view class="blob blob--3"></view>
  </view>
  <view class="auth__brand">
    <image class="auth__mark" src="/assets/icons/learn-active.png" />
    <view class="auth__logo">计科创新中心</view>
    <view class="auth__sub">学习 · 竞赛 · 项目</view>
  </view>
  <view class="auth__card">
    <view class="auth__title">欢迎登录</view>
    <view wx:if="{{needPrivacy}}" class="auth__privacy pressable" hover-class="pressing" bindtap="onAgreePrivacy">点击完成微信隐私授权</view>
    <view class="btn btn-block {{agreed ? '' : 'btn-disabled'}} pressable" hover-class="pressing" bindtap="onLogin">
      {{loading ? '登录中…' : '微信登录'}}
    </view>
    <view class="auth__agree">
      <checkbox-group bindchange="onAgreeChange">
        <label class="auth__check">
          <checkbox value="agree" checked="{{agreed}}" color="#007aff" />
          <text>已阅读并同意</text>
        </label>
      </checkbox-group>
      <text class="auth__link" bindtap="openAgreement">《隐私保护指引》</text>
    </view>
  </view>
</view>

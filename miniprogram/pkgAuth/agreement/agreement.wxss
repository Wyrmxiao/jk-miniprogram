/* pkgAuth/agreement/agreement.wxss */
.doc { padding: 40rpx 32rpx; }
.doc__title { font-size: 36rpx; font-weight: 500; }
.doc__meta { margin-top: 8rpx; font-size: 22rpx; color: var(--text-tertiary); }

.doc__section { margin-top: 32rpx; }
.doc__h { font-size: 28rpx; font-weight: 500; color: var(--text-primary); }
.doc__p { margin-top: 10rpx; font-size: 26rpx; color: var(--text-secondary); line-height: 1.7; }

.doc__tip {
  margin-top: 40rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-warning-light);
  color: var(--color-warning);
  font-size: 24rpx;
  line-height: 1.6;
}

.doc__btn {
  margin-top: 32rpx;
  padding: 24rpx;
  text-align: center;
  border-radius: var(--radius-md);
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
}

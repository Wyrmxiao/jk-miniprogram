<view class="page">
  <view class="blobs">
    <view class="blob blob--1"></view>
    <view class="blob blob--2"></view>
    <view class="blob blob--3"></view>
  </view>

  <view class="hero">
    <view class="hero__title">选择赛事</view>
    <view class="hero__sub">从赛事库挑选，加入我的赛事统计</view>
    <input
      class="hero__search"
      placeholder="搜索赛事名称"
      placeholder-class="hero__ph"
      value="{{keyword}}"
      confirm-type="search"
      bindconfirm="onSearch"
      cursor-spacing="120"
    />
  </view>

  <!-- 加入到哪个列表 -->
  <view class="seg">
    <view
      class="seg__item {{mode === 'preparing' ? 'seg__item--on' : ''}}"
      data-mode="preparing"
      bindtap="switchMode"
    >加入「正在准备」</view>
    <view
      class="seg__item {{mode === 'joined' ? 'seg__item--on' : ''}}"
      data-mode="joined"
      bindtap="switchMode"
    >标记「参加过」</view>
  </view>

  <view wx:if="{{loading}}" class="pick-state">正在加载赛事…</view>

  <view wx:elif="{{!list.length}}" class="pick-state">
    <view class="pick-state__emoji">🔍</view>
    <view>没有找到符合条件的赛事</view>
  </view>

  <view wx:else class="group">
    <view class="group__title">赛事库<text class="pick-note">共 {{total}} 项 · 点右侧按钮加入</text></view>
    <view wx:for="{{list}}" wx:key="_id" class="pick-row">
      <view class="pick-row__body pressable" hover-class="pressing" data-id="{{item._id}}" bindtap="goDetail">
        <view class="my-race__top">
          <text class="my-race__name text-2lines">{{item.name}}</text>
          <text class="level level--{{item.level}}">{{item.level}}类</text>
        </view>
        <view class="pick-row__meta">{{item.timeText}}</view>
      </view>
      <view
        wx:if="{{mode === 'preparing'}}"
        class="pick-btn pressable {{item.inPreparing ? 'pick-btn--on' : ''}}"
        hover-class="pressing"
        data-id="{{item._id}}"
        catchtap="toggle"
      >{{item.inPreparing ? '已加入' : '＋ 加入'}}</view>
      <view
        wx:else
        class="pick-btn pressable {{item.inJoined ? 'pick-btn--on' : ''}}"
        hover-class="pressing"
        data-id="{{item._id}}"
        catchtap="toggle"
      >{{item.inJoined ? '已登记' : '＋ 登记'}}</view>
    </view>
    <view wx:if="{{noMore && list.length > 8}}" class="pick-end">没有更多了</view>
  </view>
</view>

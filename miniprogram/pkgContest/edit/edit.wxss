/* pkgContest/edit/edit.wxss —— 教师端：职能蓝主题 */
.page { min-height: 100vh; background: var(--bg-page); padding: 0 var(--space-lg) var(--space-xl); }

.block {
  margin-top: var(--space-md);
  padding: var(--space-lg);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.block__title { font-size: var(--font-body); font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-md); }
.block-label { display: block; margin-top: var(--space-lg); }
.tip { font-size: var(--font-micro); color: var(--text-secondary); line-height: 1.6; margin-bottom: var(--space-sm); }

.field {
  margin-top: var(--space-md);
  padding: 20rpx var(--space-md);
  border-radius: var(--radius-md);
  background: var(--bg-block);
  font-size: var(--font-body);
}
.field--area { min-height: 140rpx; width: auto; }

.row { flex-direction: row; align-items: center; margin-top: var(--space-lg); flex-wrap: wrap; }
.row__label { font-size: var(--font-caption); color: var(--text-secondary); margin-right: var(--space-md); font-weight: 500; }
.opts { flex-direction: row; flex-wrap: wrap; }
.opt {
  padding: 12rpx 28rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: var(--radius-pill);
  background: var(--bg-block);
  font-size: var(--font-caption);
  color: var(--text-secondary);
}
.opt--on { background: var(--color-primary-light); color: var(--color-primary); font-weight: 500; }
.picker {
  padding: 12rpx var(--space-md);
  border-radius: var(--radius-md);
  background: var(--bg-block);
  font-size: var(--font-caption);
}

.months { flex-direction: row; flex-wrap: wrap; margin-top: var(--space-sm); }
.month {
  width: 96rpx;
  margin: 0 12rpx 12rpx 0;
  padding: 10rpx 0;
  text-align: center;
  border-radius: var(--radius-md);
  background: var(--bg-block);
  font-size: var(--font-caption);
  color: var(--text-secondary);
}
.month--on { background: var(--color-primary-light); color: var(--color-primary); font-weight: 500; }

.switch-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-lg);
  font-size: var(--font-caption);
  color: var(--text-secondary);
}

.actions { margin-top: var(--space-lg); }
.btn-block { display: block; width: 100%; text-align: center; height: 88rpx; line-height: 88rpx; border-radius: var(--radius-pill); font-size: var(--font-body); font-weight: 600; margin-bottom: var(--space-md); }
.btn-primary { background: var(--color-teacher); color: #fff; }
.btn-danger { background: var(--color-danger-light); color: var(--color-danger); font-weight: 500; }

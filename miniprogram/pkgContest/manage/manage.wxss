/* pkgContest/manage/manage.wxss —— Apple 风格赛事维护 */
.page { min-height: 100vh; background: var(--bg-page); padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.list { padding: var(--space-sm) var(--space-lg) 0; }
.card {
  margin: 0 0 var(--space-md); padding: var(--space-lg);
  background: var(--bg-card); border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.card__head { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
.card__title { flex: 1; font-size: var(--font-body); font-weight: 560; color: var(--text-primary); line-height: 1.5; }
.state { padding: var(--space-xl) 0; text-align: center; font-size: var(--font-caption); color: var(--text-secondary); }

/* 筛选 chips（白底胶囊，与赛事库一致） */
.chips { white-space: nowrap; padding: var(--space-sm) var(--space-lg) var(--space-xs); }
.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: var(--space-sm);
  border-radius: var(--radius-pill);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
  font-size: var(--font-caption);
  color: var(--text-secondary);
  min-height: 80rpx;
}
.chip--on { background: var(--color-primary); color: #fff; font-weight: 500; }

.count { padding: var(--space-sm) var(--space-lg); font-size: var(--font-micro); color: var(--text-tertiary); }

.card__time { display: flex; flex-direction: row; align-items: center; margin-top: var(--space-sm); font-size: var(--font-caption); color: var(--color-primary); }
.card__dot { width: 12rpx; height: 12rpx; margin-right: var(--space-sm); border-radius: 50%; }
.card__dot--ok { background: var(--color-success); }
.card__dot--todo { background: var(--color-warning); }
.card__time-todo { color: var(--color-warning); }
.card__meta { display: flex; flex-direction: row; align-items: center; margin-top: var(--space-sm); font-size: var(--font-micro); color: var(--text-tertiary); flex-wrap: wrap; }
.card__focus { color: var(--color-warning); }
.card__edit { margin-left: auto; color: var(--color-primary); font-weight: 500; }

/* 新增按钮 */
.fab { transition: transform var(--duration-press) var(--ease-spring), opacity var(--duration-press) ease; position: fixed; right: var(--space-lg); bottom: calc(var(--space-lg) + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: center; min-width: 176rpx; height: 96rpx; padding: 0 var(--space-md); border-radius: var(--radius-pill); background: var(--color-primary); color: var(--text-inverse); font-size: var(--font-body); font-weight: 560; box-shadow: var(--shadow-float); z-index: 20; }

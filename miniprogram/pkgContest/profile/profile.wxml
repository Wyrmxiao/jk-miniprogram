<view class="page">
  <view class="blobs">
    <view class="blob blob--1"></view>
    <view class="blob blob--2"></view>
    <view class="blob blob--3"></view>
  </view>

  <view wx:if="{{loading}}" class="state">正在加载…</view>

  <block wx:else>
    <!-- 主页头部 -->
    <view class="profile">
      <view class="profile__avatar">{{user && user.name ? user.name[0] : '同'}}</view>
      <view class="profile__info">
        <view class="profile__name">{{user ? (user.name || '同学') : '微信用户'}}</view>
        <view wx:if="{{user}}" class="profile__tags">
          <text class="tag tag-primary">{{user.major || '专业未填写'}}</text>
          <text class="tag">{{user.grade || '年级未填写'}}</text>
        </view>
        <button wx:if="{{isSelf}}" class="share-btn pressable" hover-class="pressing" bindtap="copyLink">复制主页链接</button>
      </view>
    </view>

    <!-- 赛事统计入口 -->
    <view class="group">
      <view class="cell pressable" hover-class="pressing" bindtap="goMyStats">
        <view class="cell__body">
          <view class="cell__title">赛事统计</view>
          <view class="cell__desc">正在准备的比赛 · 参加过的比赛</view>
        </view>
        <text class="cell__chevron">›</text>
      </view>
    </view>

    <!-- 已完成项目：只展示名称与项目介绍，详情需申请 -->
    <view class="group proj-group">
      <view class="proj-head">
        <view class="cell__title">已完成项目</view>
        <text wx:if="{{projects.length}}" class="proj-count">{{projects.length}}</text>
      </view>

      <block wx:if="{{projects.length}}">
        <view
          wx:for="{{projects}}"
          wx:key="_id"
          class="proj-cell pressable"
          hover-class="pressing"
          data-id="{{item._id}}"
          data-open="{{item.open ? 1 : 0}}"
          bindtap="goProject"
        >
          <view class="proj-cell__name">{{item.name}}</view>
          <view wx:if="{{item.summary}}" class="proj-cell__summary">{{item.summary}}</view>
          <view class="proj-cell__hint">{{item.open ? '点击查看详情' : '申请通过后可查看详情'}}</view>
        </view>
        <view wx:if="{{!isSelf}}" class="proj-tip">项目介绍对外可见，查看详情需 TA 在「项目 · 信息」里通过你的申请</view>
      </block>
      <view wx:else class="proj-empty">
        {{isSelf ? '还没有已完成的项目，在「项目」里把项目阶段改为「已完成」后会展示在这里' : 'TA 还没有展示已完成的项目'}}
      </view>
    </view>

    <view wx:if="{{isSelf}}" class="profile-foot">复制链接发给微信好友，对方点开即可查看你的主页</view>
  </block>
</view>

{
  "pages": [
    "pages/index/index",
    "pages/learn/learn",
    "pages/contest/contest",
    "pages/contest/detail/detail",
    "pages/project/project",
    "pages/project/detail",
    "pages/mine/mine"
  ],
  "subpackages": [
    {
      "root": "pkgAuth",
      "name": "pkgAuth",
      "pages": [
        "login/login",
        "realname/realname",
        "agreement/agreement"
      ]
    },
    {
      "root": "pkgContest",
      "name": "pkgContest",
      "pages": [
        "manage/manage",
        "edit/edit"
      ]
    },
    {
      "root": "pkgWork",
      "name": "pkgWork",
      "pages": [
        "announce/publish",
        "announce/list",
        "announce/detail",
        "task/publish",
        "log/edit",
        "project/edit",
        "admin/users/users"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": [
        "pkgAuth",
        "pkgWork"
      ]
    },
    "pages/contest/contest": {
      "network": "all",
      "packages": [
        "pkgContest"
      ]
    },
    "pages/learn/learn": {
      "network": "all",
      "packages": [
        "pkgWork"
      ]
    },
    "pages/mine/mine": {
      "network": "all",
      "packages": [
        "pkgWork"
      ]
    }
  },
  "window": {
    "navigationBarBackgroundColor": "#f4f1ec",
    "navigationBarTitleText": "计科创新中心",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f4f1ec",
    "backgroundTextStyle": "dark",
    "enablePullDownRefresh": false
  },
  "tabBar": {
    "color": "#9d988e",
    "selectedColor": "#6b8ca3",
    "backgroundColor": "#fffdf9",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "assets/icons/home.png",
        "selectedIconPath": "assets/icons/home-active.png"
      },
      {
        "pagePath": "pages/learn/learn",
        "text": "学习",
        "iconPath": "assets/icons/learn.png",
        "selectedIconPath": "assets/icons/learn-active.png"
      },
      {
        "pagePath": "pages/contest/contest",
        "text": "竞赛",
        "iconPath": "assets/icons/contest.png",
        "selectedIconPath": "assets/icons/contest-active.png"
      },
      {
        "pagePath": "pages/project/project",
        "text": "项目",
        "iconPath": "assets/icons/project.png",
        "selectedIconPath": "assets/icons/project-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "assets/icons/mine.png",
        "selectedIconPath": "assets/icons/mine-active.png"
      }
    ]
  },
  "usingComponents": {},
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "style": "v2"
}

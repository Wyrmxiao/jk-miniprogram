/* 涟漪层：全屏铺开但不拦截任何点击 */
.ripple-layer {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  pointer-events: none;
}

/* 单个涟漪：触点原地生成，放大 + 渐隐 */
.ripple {
  position: fixed;
  width: 40rpx;
  height: 40rpx;
  margin-left: -20rpx;
  margin-top: -20rpx;
  border-radius: 50%;
  background: rgba(120, 120, 128, 0.16);
  pointer-events: none;
  animation: ripple-fade 0.5s ease-out forwards;
}

@keyframes ripple-fade {
  0% {
    transform: scale(0.4);
    opacity: 0.9;
  }
  100% {
    transform: scale(2.6);
    opacity: 0;
  }
}
